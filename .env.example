# Optional overrides for docker compose ports and database credentials.

PULSEFLOW_ZOOKEEPER_PORT=2181
PULSEFLOW_KAFKA_PORT=9092
PULSEFLOW_FLASHCACHE_PORT=7654
PULSEFLOW_FLASHCACHE_METRICS_PORT=7655
PULSEFLOW_POSTGRES_PORT=5433
PULSEFLOW_KAFKA_UI_PORT=8090

PULSEFLOW_GATEWAY_PORT=8080
PULSEFLOW_UI_PORT=3000

PULSEFLOW_POSTGRES_USER=pulseflow
PULSEFLOW_POSTGRES_PASSWORD=pulseflow
PULSEFLOW_POSTGRES_DB=pulseflow

# ntfy.sh push topic for successful job notifications (subscribe in https://ntfy.sh/app)
PULSEFLOW_NTFY_TOPIC=pulseflow-dev-change-me
